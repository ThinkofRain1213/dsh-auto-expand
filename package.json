{
  "name": "dsh-auto-expand",
  "version": "0.2.1",
  "description": "DSH plugin: keep the running turn's work visible — process groups, reasoning and tool results expand automatically and fold once the group ends, leaving history untouched.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkofRain1213/dsh-auto-expand.git"
  },
  "homepage": "https://github.com/ThinkofRain1213/dsh-auto-expand#readme",
  "bugs": {
    "url": "https://github.com/ThinkofRain1213/dsh-auto-expand/issues"
  },
  "main": "lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/normalize-bundle.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "node --experimental-transform-types --test tests/auto-disclosure.spec.mjs tests/wrap.spec.mjs tests/reasoning-auto-open.spec.mjs tests/scroll-init.spec.mjs tests/scroll-align.spec.mjs tests/process-scroll.spec.mjs tests/settings-write.spec.mjs tests/drift-manifest.spec.mjs tests/contract-consistency.spec.mjs tests/settings-card-state.spec.mjs tests/tool-disclosure.spec.mjs tests/collapse-timing.spec.mjs tests/inspect-button-scope.spec.mjs tests/group-height.spec.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm smoke && pnpm verify:css-isolation",
    "verify:css-isolation": "node scripts/verify-css-isolation.mjs",
    "verify:full": "pnpm verify && pnpm drift",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "pnpm verify && pnpm verify:release",
    "drift": "node scripts/check-drift.mjs",
    "drift:record": "node scripts/record-upstream.mjs",
    "pack:check": "pnpm build && node scripts/check-pack.mjs",
    "prepack": "pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.2.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat",
    "reasoning",
    "disclosure"
  ]
}
